# Keep only app and backend tracked
# Everything else in the repo root is ignored by default unless explicitly added.
# If you need to force-track a root file, use: git add -f path/to/file

# Common generated artifacts
current_download/
downloads/
downloads_old_song/
albums/
*.js
!app/**/*.js
!backend/**/*.py
!backend/**/*.txt
!backend/Dockerfile
!backend/.dockerignore
!backend/requirements.txt
